# Export these variables in the server process; this file is not loaded automatically.
APP_DATA_SOURCE=fixture
# APP_FIXTURE_DIR=/absolute/path/to/fixtures
# APP_DATA_SOURCE=snapshot
# APP_SNAPSHOT_DIR=/absolute/path/to/snapshot
# APP_DATA_SOURCE=clickhouse_snapshot
# Set APP_SNAPSHOT_DIR to the matching one-day reference snapshot.
# For the local APP-07 rehearsal, set APP_CLICKHOUSE_PORT=18123.
# For APP_DATA_SOURCE=clickhouse, use the APP-02 serving database (e.g. app_serving) and HTTPS.
APP_CLICKHOUSE_HOST=localhost
APP_CLICKHOUSE_SECURE=false
APP_CLICKHOUSE_PORT=8123
APP_CLICKHOUSE_USER=reposcope_reader
APP_CLICKHOUSE_PASSWORD=
APP_CLICKHOUSE_DATABASE=gold
APP_CLICKHOUSE_CONNECT_TIMEOUT=5
APP_CLICKHOUSE_QUERY_TIMEOUT=30
# Enable only for an approved ML-04 release with a measured freshness SLA.
# APP_ENABLE_PREDICTIONS=1
# APP_PREDICTION_RELEASE_ID=
# APP_PREDICTION_MAX_AGE_HOURS=
# APP_PIPELINE_RUNS_FILE=/absolute/path/to/app10-airflow-runs.json
